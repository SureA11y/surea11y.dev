---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import Sidebar from "../components/Sidebar.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TableOfContents from "../components/TableOfContents.astro";
import Footer from "../components/Footer.astro";
import { Callout } from "../components/design-system/feedback/Callout.jsx";
import { processHeadings } from "../utils/headings";
import { localizeLinks } from "../utils/localizeLinks";
import { markCodeNoTranslate } from "../utils/noTranslate";
import { t } from "../i18n/t";
import { DEFAULT_LOCALE, localeCodes, type Locale } from "../i18n/locales";
import { localizePath, splitLocale } from "../i18n/paths";

interface Props {
	title: string;
	/** Falls back to a sitewide default when a page doesn't pass one. */
	description?: string;
	/** Only needed for generated pages whose URL isn't in siteTree (rule detail pages). */
	breadcrumbLabel?: string;
	/**
	 * The language the page's own content is written in, when it differs from
	 * the URL's locale — i.e. an untranslated page shown in English under
	 * /es/…. Marks the content with the right `lang`, adds a notice, and
	 * points the canonical URL at the English original.
	 */
	contentLocale?: Locale;
	/** Locales this page is actually translated into, for hreflang. Defaults to all. */
	translatedLocales?: Locale[];
	/**
	 * Show the "on this page" rail (default). A page whose content needs the
	 * width more than a short heading list (the rules catalog table) turns it off.
	 */
	toc?: boolean;
}

const { title, description, breadcrumbLabel, translatedLocales = localeCodes, toc = true } = Astro.props;
const { locale, path } = splitLocale(Astro.url.pathname);
const contentLocale = Astro.props.contentLocale ?? locale;
const untranslated = contentLocale !== locale;

const pageTitle = `${title} · surea11y`;
const pageDescription = description ?? t("layout.defaultDescription", contentLocale);

const canonicalUrl = new URL(untranslated ? localizePath(path, contentLocale) : Astro.url.pathname, Astro.site);
const alternates = translatedLocales.map((l) => ({ hreflang: l, href: new URL(localizePath(path, l), Astro.site) }));
const defaultUrl = new URL(localizePath(path, DEFAULT_LOCALE), Astro.site);

const rawHtml = await Astro.slots.render("default");
const { html: headedHtml, headings } = processHeadings(rawHtml);
const html = markCodeNoTranslate(localizeLinks(headedHtml, locale));
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" href="/favicon.ico" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={canonicalUrl} />
		{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
		<link rel="alternate" hreflang="x-default" href={defaultUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="surea11y" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
	</head>
	<body>
		<a class="skip-link" href="#main-content">{t("layout.skipToContent", locale)}</a>
		<SiteNav locale={locale} />
		<div class:list={["shell", { "no-toc": !toc }]}>
			<details class="sidebar-toggle">
				<summary>{t("layout.siteMenu", locale)}</summary>
				<div class="sidebar-body"><Sidebar locale={locale} /></div>
			</details>
			<div class="content-col">
				{path !== "/" && (
					<Breadcrumbs locale={locale} breadcrumbLabel={breadcrumbLabel} />
				)}
				<main id="main-content">
					{untranslated && (
						<Callout tone="note" title={t("layout.untranslatedTitle", locale)} className="untranslated-notice">
							<p>{t("layout.untranslatedBody", locale)}</p>
						</Callout>
					)}
					<div class="prose" lang={untranslated ? contentLocale : undefined} set:html={html} />
				</main>
			</div>
			{toc && (
				<aside class="toc-rail">
					<TableOfContents headings={headings} locale={locale} />
				</aside>
			)}
		</div>
		<Footer locale={locale} />
	</body>
</html>

<style>
	body {
		background: var(--surface);
		color: var(--text-body);
		font-family: var(--font-body);
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.shell {
		flex: 1;
	}

	.skip-link {
		position: absolute;
		top: -100%;
		left: var(--space-4);
		background: var(--surface-raised);
		color: var(--text-strong);
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-md);
		z-index: 10;
	}

	.skip-link:focus-visible {
		top: var(--space-4);
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
	}

	.shell {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-8);
		align-items: start;
		padding: var(--space-8) var(--space-6);
	}

	@media (min-width: 900px) {
		.shell {
			grid-template-columns: 240px minmax(0, 1fr);
		}
	}

	@media (min-width: 1200px) {
		.shell {
			grid-template-columns: 240px minmax(0, 1fr) 220px;
		}

		.shell.no-toc {
			grid-template-columns: 240px minmax(0, 1fr);
		}
	}

	.sidebar-toggle {
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
	}

	.sidebar-toggle > summary {
		cursor: pointer;
		list-style: none;
		padding: var(--space-3) var(--space-4);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		color: var(--text-strong);
	}

	.sidebar-toggle > summary::-webkit-details-marker {
		display: none;
	}

	.sidebar-toggle .sidebar-body {
		padding: 0 var(--space-3) var(--space-3);
	}

	@media (min-width: 900px) {
		.sidebar-toggle {
			border: none;
			position: sticky;
			top: var(--space-6);
			align-self: start;
			max-height: calc(100vh - var(--space-12));
			overflow-y: auto;
		}

		.sidebar-toggle > summary {
			display: none;
		}

		.sidebar-toggle .sidebar-body {
			display: block !important;
			padding: 0;
		}

		/* Chromium collapses a closed <details>'s content into an internal
		   ::details-content box (content-visibility: hidden, height: 0)
		   that overriding the child's own display can't undo. */
		.sidebar-toggle::details-content {
			content-visibility: visible !important;
			height: auto !important;
			overflow: visible !important;
		}
	}

	.toc-rail {
		display: none;
	}

	@media (min-width: 1200px) {
		.toc-rail {
			display: block;
			position: sticky;
			top: var(--space-6);
			align-self: start;
		}
	}

	main :global(.untranslated-notice) {
		margin-bottom: var(--space-6);
	}

	.prose :global(h1) {
		font-family: var(--font-display);
		color: var(--text-strong);
	}

	/* A single word wider than the column (German compounds at heading size,
	   "WCAG-Konformitätszuordnung" on a phone, or "aria-labelledby/
	   aria-describedby" in rule text) breaks instead of pushing the page
	   sideways. It only kicks in when the word can't fit, and code blocks
	   don't wrap at all, so they keep scrolling inside their own box. */
	.prose {
		overflow-wrap: break-word;
	}

	.prose :global(h2) {
		font-family: var(--font-display);
		color: var(--text-strong);
		font-size: var(--text-lg);
		margin-top: var(--space-10);
	}

	.prose :global(h3) {
		font-family: var(--font-display);
		color: var(--text-strong);
		font-size: var(--text-md);
		margin-top: var(--space-8);
	}

	.prose :global(p),
	.prose :global(li) {
		line-height: var(--leading-relaxed);
	}

	.prose :global(li) {
		margin-bottom: var(--space-3);
	}

	.prose :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
	}

	/* Long inline identifiers (engineOptions.rules[ruleId].excludeSelectors)
	   would otherwise push the page wider than a phone screen. Code blocks
	   keep their own horizontal scrolling. */
	.prose :global(:not(pre) > code) {
		overflow-wrap: anywhere;
	}
</style>
