---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import Sidebar from "../components/Sidebar.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TableOfContents from "../components/TableOfContents.astro";
import Footer from "../components/Footer.astro";
import { processHeadings } from "../utils/headings";
import { resolveLocale } from "../i18n/t";

interface Props {
	title: string;
	/** Falls back to a sitewide default when a page doesn't pass one. */
	description?: string;
	/** Only needed for generated pages whose URL isn't in siteTree (rule detail pages). */
	breadcrumbLabel?: string;
}

const DEFAULT_DESCRIPTION =
	"Deterministic WCAG 2.2 accessibility testing for Playwright, Cypress, Puppeteer, Selenium, WebdriverIO, Jest/Vitest, and CI.";

const { title, description = DEFAULT_DESCRIPTION, breadcrumbLabel } = Astro.props;
const pageTitle = `${title} · surea11y`;
const locale = resolveLocale(Astro.currentLocale);

const pathNoLocale = Astro.url.pathname.replace(/^\/es(?=\/|$)/, "") || "/";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const enUrl = new URL(pathNoLocale, Astro.site);
const esUrl = new URL(`/es${pathNoLocale}`, Astro.site);

const rawHtml = await Astro.slots.render("default");
const { html, headings } = processHeadings(rawHtml);
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" href="/favicon.ico" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="es" href={esUrl} />
		<link rel="alternate" hreflang="x-default" href={enUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="surea11y" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteNav locale={locale} />
		<div class="shell">
			<details class="sidebar-toggle">
				<summary>Site menu</summary>
				<div class="sidebar-body"><Sidebar locale={locale} /></div>
			</details>
			<div class="content-col">
				{Astro.url.pathname !== "/" && Astro.url.pathname !== "/es/" && (
					<Breadcrumbs locale={locale} breadcrumbLabel={breadcrumbLabel} />
				)}
				<main id="main-content">
					<div class="prose" set:html={html} />
				</main>
			</div>
			<aside class="toc-rail">
				<TableOfContents headings={headings} locale={locale} />
			</aside>
		</div>
		<Footer locale={locale} />
	</body>
</html>

<style>
	body {
		background: var(--surface);
		color: var(--text-body);
		font-family: var(--font-body);
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.shell {
		flex: 1;
	}

	.skip-link {
		position: absolute;
		top: -100%;
		left: var(--space-4);
		background: var(--surface-raised);
		color: var(--text-strong);
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-md);
		z-index: 10;
	}

	.skip-link:focus-visible {
		top: var(--space-4);
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
	}

	.shell {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-8);
		align-items: start;
		padding: var(--space-8) var(--space-6);
	}

	@media (min-width: 900px) {
		.shell {
			grid-template-columns: 240px minmax(0, 1fr);
		}
	}

	@media (min-width: 1200px) {
		.shell {
			grid-template-columns: 240px minmax(0, 1fr) 220px;
		}
	}

	.sidebar-toggle {
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
	}

	.sidebar-toggle > summary {
		cursor: pointer;
		list-style: none;
		padding: var(--space-3) var(--space-4);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		color: var(--text-strong);
	}

	.sidebar-toggle > summary::-webkit-details-marker {
		display: none;
	}

	.sidebar-toggle .sidebar-body {
		padding: 0 var(--space-3) var(--space-3);
	}

	@media (min-width: 900px) {
		.sidebar-toggle {
			border: none;
			position: sticky;
			top: var(--space-6);
			align-self: start;
			max-height: calc(100vh - var(--space-12));
			overflow-y: auto;
		}

		.sidebar-toggle > summary {
			display: none;
		}

		.sidebar-toggle .sidebar-body {
			display: block !important;
			padding: 0;
		}

		/* Chromium collapses a closed <details>'s content into an internal
		   ::details-content box (content-visibility: hidden, height: 0)
		   that overriding the child's own display can't undo. */
		.sidebar-toggle::details-content {
			content-visibility: visible !important;
			height: auto !important;
			overflow: visible !important;
		}
	}

	.toc-rail {
		display: none;
	}

	@media (min-width: 1200px) {
		.toc-rail {
			display: block;
			position: sticky;
			top: var(--space-6);
			align-self: start;
		}
	}

	.prose :global(h1) {
		font-family: var(--font-display);
		color: var(--text-strong);
	}

	.prose :global(h2) {
		font-family: var(--font-display);
		color: var(--text-strong);
		font-size: var(--text-lg);
		margin-top: var(--space-10);
	}

	.prose :global(h3) {
		font-family: var(--font-display);
		color: var(--text-strong);
		font-size: var(--text-md);
		margin-top: var(--space-8);
	}

	.prose :global(p),
	.prose :global(li) {
		line-height: var(--leading-relaxed);
	}

	.prose :global(li) {
		margin-bottom: var(--space-3);
	}

	.prose :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
	}
</style>
