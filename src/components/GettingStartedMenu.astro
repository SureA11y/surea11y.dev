---
import { gettingStartedSections } from "../data/gettingStartedSections";

const currentPath = Astro.url.pathname;
---

<nav aria-label="Usage guides" class="usage-menu">
	<span class="usage-menu-label">Usage guides</span>
	<ul>
		{
			gettingStartedSections.map((section) => (
				<li>
					<a href={section.href} aria-current={currentPath === section.href ? "page" : undefined}>
						{section.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.usage-menu {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-4);
		margin: var(--space-6) 0 var(--space-8);
		padding: var(--space-3) var(--space-4);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
	}

	.usage-menu-label {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--text-muted);
		flex: none;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	a {
		display: inline-flex;
		align-items: center;
		min-height: var(--target-min);
		padding: 0 var(--space-3);
		border-radius: var(--radius-sm);
		border-bottom: 2px solid transparent;
		color: var(--text-body);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		text-decoration: none;
	}

	a:hover {
		color: var(--text-strong);
	}

	a[aria-current="page"] {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}
</style>
