---
import { siteTree } from "../data/siteTree";
import { localize } from "../data/localize";
import { t, type Locale } from "../i18n/t";

interface Props {
	locale?: Locale;
	breadcrumbLabel?: string;
}

const { locale = "en", breadcrumbLabel } = Astro.props;
const localePrefix = locale === "es" ? "/es" : "";
const currentPath =
	locale === "es" ? Astro.url.pathname.replace(/^\/es(?=\/|$)/, "") || "/" : Astro.url.pathname;
const section = siteTree.find(
	(s) => currentPath === s.href || (s.href !== "/" && currentPath.startsWith(s.href))
);
const child = section?.children.find((c) => currentPath === c.href);
const sectionLabel = section ? localize(section, locale).label : undefined;
const childLabel = child ? localize(child, locale).label : undefined;
---

<nav aria-label={t("breadcrumbs.nav", locale)} class="breadcrumbs">
	<ol>
		<li>
			<a href={`${localePrefix}/`} aria-label={t("breadcrumbs.home", locale)} class="home-link">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"></path>
					<path d="M9 22V12h6v10"></path>
				</svg>
			</a>
		</li>
		{
			section && section.href !== "/" && (
				<li>
					{child || breadcrumbLabel ? (
						<a href={`${localePrefix}${section.href}`}>{sectionLabel}</a>
					) : (
						<span aria-current="page">{sectionLabel}</span>
					)}
				</li>
			)
		}
		{child && (
			<li>
				<span aria-current="page">{childLabel}</span>
			</li>
		)}
		{!child && breadcrumbLabel && (
			<li>
				<span aria-current="page">{breadcrumbLabel}</span>
			</li>
		)}
	</ol>
</nav>

<style>
	.breadcrumbs ol {
		list-style: none;
		margin: 0 0 var(--space-6);
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-body);
		font-size: var(--text-sm);
	}

	.breadcrumbs li {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.breadcrumbs li:not(:first-child)::before {
		content: "/";
		color: var(--text-muted);
	}

	.breadcrumbs a {
		color: var(--text-muted);
		text-decoration: none;
	}

	.breadcrumbs .home-link {
		display: inline-flex;
		align-items: center;
	}

	.breadcrumbs a:hover {
		color: var(--text-strong);
	}

	.breadcrumbs a:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
		border-radius: var(--radius-sm);
	}

	.breadcrumbs [aria-current="page"] {
		color: var(--text-body);
	}
</style>
