---
import { t, type Locale } from "../i18n/t";
import { locales } from "../i18n/locales";
import { localizePath, splitLocale } from "../i18n/paths";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { path } = splitLocale(Astro.url.pathname);
const current = locales.find((l) => l.code === locale)!;
// Every locale builds every page (untranslated ones fall back to English
// content), so the same path always exists in each language.
const options = locales.map((l) => ({ ...l, href: localizePath(path, l.code) }));
const others = options.filter((o) => o.code !== locale);
---

{
	others.length === 0 ? null : others.length === 1 ? (
		<a href={others[0].href} class="language-link" hreflang={others[0].code} lang={others[0].code}>
			{others[0].name}
		</a>
	) : (
		<details class="language-menu">
			<summary class="language-link">
				<span class="visually-hidden">{t("languageSwitcher.label", locale)}: </span>
				{current.name}
			</summary>
			<ul>
				{options.map((o) => (
					<li>
						<a
							href={o.href}
							hreflang={o.code}
							lang={o.code}
							aria-current={o.code === locale ? "true" : undefined}
						>
							{o.name}
						</a>
					</li>
				))}
			</ul>
		</details>
	)
}

<style>
	.language-link {
		display: inline-flex;
		align-items: center;
		min-height: var(--target-min);
		padding: 0 var(--space-3);
		border-radius: var(--radius-sm);
		color: var(--text-muted);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		text-decoration: none;
		cursor: pointer;
	}

	.language-link:hover {
		color: var(--text-strong);
	}

	.language-link:focus-visible,
	.language-menu a:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
	}

	.language-menu {
		position: relative;
	}

	.language-menu > summary {
		list-style: none;
		gap: var(--space-2);
	}

	.language-menu > summary::-webkit-details-marker {
		display: none;
	}

	.language-menu > summary::after {
		content: "▾";
		transition: transform var(--duration-fast) var(--ease-standard);
	}

	.language-menu[open] > summary::after {
		transform: rotate(180deg);
	}

	.language-menu ul {
		position: absolute;
		right: 0;
		z-index: 20;
		min-width: 12rem;
		margin: var(--space-1) 0 0;
		padding: var(--space-1);
		list-style: none;
		background: var(--surface-raised);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
	}

	.language-menu a {
		display: flex;
		align-items: center;
		min-height: var(--target-min);
		padding: 0 var(--space-3);
		border-radius: var(--radius-sm);
		border-bottom: 2px solid transparent;
		color: var(--text-body);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		text-decoration: none;
	}

	.language-menu a:hover {
		color: var(--text-strong);
	}

	/* Same non-color-only current-item cue as the sidebar. */
	.language-menu a[aria-current="true"] {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
