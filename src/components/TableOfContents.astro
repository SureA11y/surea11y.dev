---
import { nestHeadings, type HeadingEntry } from "../utils/headings";

interface Props {
	headings: HeadingEntry[];
}

const { headings } = Astro.props;
const tree = nestHeadings(headings);
---

{
	tree.length > 0 && (
		<nav aria-label="On this page" class="toc">
			<span class="toc-label">On this page</span>
			<ul>
				{tree.map((h) => (
					<li>
						<a href={`#${h.id}`}>{h.text}</a>
						{h.children.length > 0 && (
							<ul>
								{h.children.map((c) => (
									<li>
										<a href={`#${c.id}`}>{c.text}</a>
									</li>
								))}
							</ul>
						)}
					</li>
				))}
			</ul>
		</nav>
	)
}

<style>
	/*
	  Static link list only — no scroll-spy/active-heading highlighting,
	  since that needs an IntersectionObserver and this site ships zero
	  client-side JS by design.
	*/
	.toc {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.toc-label {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--text-muted);
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	ul ul {
		padding-left: var(--space-4);
		margin-top: var(--space-1);
	}

	a {
		display: inline-flex;
		align-items: center;
		min-height: var(--target-min);
		color: var(--text-body);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		text-decoration: none;
		line-height: var(--leading-snug);
	}

	a:hover {
		color: var(--text-strong);
	}

	a:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
		border-radius: var(--radius-sm);
	}
</style>
