---
import { Logo } from "./design-system/brand/Logo.jsx";
---

<header class="site-header">
	<a class="wordmark" href="/">
		<Logo variant="lockup" case="lower" size={28} />
	</a>
</header>

<style>
	.site-header {
		display: flex;
		align-items: center;
		padding: var(--space-4) var(--space-6);
		border-bottom: 1px solid var(--border);
	}

	.wordmark {
		display: inline-flex;
		text-decoration: none;
	}
</style>
