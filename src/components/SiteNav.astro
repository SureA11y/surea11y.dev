---
import { Logo } from "./design-system/brand/Logo.jsx";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { t, type Locale } from "../i18n/t";
import { localizePath } from "../i18n/paths";

interface Props {
	locale?: Locale;
}

const { locale = "en" } = Astro.props;
const homeHref = localizePath("/", locale);
const githubLabel = t("siteNav.githubLabel", locale);
const npmLabel = t("siteNav.npmLabel", locale);
---

<header class="site-header">
	<a class="wordmark" href={homeHref}>
		<Logo variant="lockup" case="lower" size={28} />
	</a>
	<div class="external-links">
		<LanguageSwitcher locale={locale} />
		<a href="https://github.com/SureA11y/core" aria-label={githubLabel} title={githubLabel} class="icon-link">
			<svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
				<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
			</svg>
		</a>
		<a href="https://www.npmjs.com/package/@surea11y/core" aria-label={npmLabel} title={npmLabel} class="icon-link">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
				<path d="m3.3 7 8.7 5 8.7-5M12 22V12"></path>
			</svg>
		</a>
	</div>
</header>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: var(--space-4) var(--space-6);
		border-bottom: 1px solid var(--border);
	}

	.wordmark {
		display: inline-flex;
		text-decoration: none;
	}

	.external-links {
		display: flex;
		gap: var(--space-1);
	}

	.icon-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--target-min);
		height: var(--target-min);
		border-radius: var(--radius-sm);
		color: var(--text-muted);
	}

	.icon-link:hover {
		color: var(--text-strong);
	}

	.icon-link:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
	}
</style>
