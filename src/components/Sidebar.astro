---
import { siteTree } from "../data/siteTree";
import { localize } from "../data/localize";
import { t, type Locale } from "../i18n/t";
import { localizePath, splitLocale } from "../i18n/paths";

interface Props {
	locale?: Locale;
}

const { locale = "en" } = Astro.props;
const withLocale = (href: string) => localizePath(href, locale);
const currentPath = splitLocale(Astro.url.pathname).path;
const isSectionActive = (href: string) =>
	href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<nav aria-label={t("sidebar.nav", locale)} class="tree">
	<ul class="tree-root">
		{
			siteTree.map((section) => {
				const { label } = localize(section, locale);
				const hasChildren = section.children.length > 0;
				const onIndex = currentPath === section.href;
				const open = isSectionActive(section.href);
				return (
					<li class="tree-section">
						<div class="tree-section-head">
							<a href={withLocale(section.href)} aria-current={onIndex ? "page" : undefined}>
								{label}
							</a>
							{hasChildren && (
								<details open={open}>
									<summary aria-label={t("sidebar.subpages", locale, { section: label })} />
								</details>
							)}
						</div>
						{hasChildren && (
							<ul class="tree-children">
								{section.children.map((child) => {
									const { label: childLabel } = localize(child, locale);
									return (
										<li>
											<a
												href={withLocale(child.href)}
												aria-current={currentPath === child.href ? "page" : undefined}
											>
												{childLabel}
											</a>
										</li>
									);
								})}
							</ul>
						)}
					</li>
				);
			})
		}
	</ul>
</nav>

<style>
	.tree-root {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.tree-section-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
	}

	.tree-section-head a {
		display: inline-flex;
		align-items: center;
		min-height: var(--target-min);
		padding: 0 var(--space-3);
		border-radius: var(--radius-sm);
		color: var(--text-body);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		text-decoration: none;
		flex: 1;
	}

	.tree-section-head a:hover {
		color: var(--text-strong);
	}

	.tree-section-head a:focus-visible {
		/* Inset, not outset: this sits inside a scrolling column, so an
		   outward ring on the first/last row or either side edge would get
		   clipped by the container's own overflow. */
		outline: 2px solid var(--focus-ring);
		outline-offset: -2px;
	}

	/* Current page: a very light accent tint plus a bar on the left edge.
	   The bar is the cue that doesn't rely on colour, and as a real border
	   (not a shadow) it survives Windows High Contrast mode, where
	   backgrounds are dropped. Only the current link has a border at all,
	   and its padding shrinks by the bar's width so the text doesn't shift. */
	.tree-section-head a[aria-current="page"],
	.tree-children a[aria-current="page"] {
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 8%, transparent);
		border-left: 3px solid var(--accent);
		border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
		padding-left: calc(var(--space-3) - 3px);
	}

	.tree-section-head details {
		flex: none;
	}

	.tree-section-head summary {
		list-style: none;
		cursor: pointer;
		width: var(--target-min);
		height: var(--target-min);
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-sm);
	}

	.tree-section-head summary::-webkit-details-marker {
		display: none;
	}

	.tree-section-head summary::before {
		content: "▸";
		display: inline-block;
		font-size: var(--text-xl);
		color: var(--text-muted);
		transition: transform var(--duration-fast) var(--ease-standard);
	}

	.tree-section-head details[open] summary::before {
		transform: rotate(90deg);
	}

	.tree-section-head summary:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: -2px;
	}

	.tree-children {
		display: none;
		list-style: none;
		margin: var(--space-1) 0 0;
		padding-left: var(--space-4);
	}

	.tree-section:has(details[open]) .tree-children {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.tree-children a {
		display: flex;
		align-items: center;
		min-height: var(--target-min);
		padding: 0 var(--space-3);
		border-radius: var(--radius-sm);
		color: var(--text-muted);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		text-decoration: none;
	}

	.tree-children a:hover {
		color: var(--text-strong);
	}

	.tree-children a:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: -2px;
	}

</style>
