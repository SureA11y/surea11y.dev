---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionMenu from "../../../components/SectionMenu.astro";
import { configurationSections } from "../../../data/configurationSections";
import { CiIntegrationContent } from "../../../components/CiIntegrationContent.jsx";
---

<BaseLayout title="CI integration">
	<h1>CI integration</h1>
	<SectionMenu sections={configurationSections} />
	<CiIntegrationContent />
</BaseLayout>

<style>
	h1 {
		font-family: var(--font-display);
		color: var(--text-strong);
	}

	:global(h2) {
		font-family: var(--font-display);
		color: var(--text-strong);
		font-size: var(--text-lg);
		margin-top: var(--space-10);
	}

	:global(h3) {
		font-family: var(--font-display);
		color: var(--text-strong);
		font-size: var(--text-md);
		margin-top: var(--space-8);
	}

	:global(p),
	:global(li) {
		line-height: var(--leading-relaxed);
	}

	:global(li) {
		margin-bottom: var(--space-3);
	}

	:global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
	}
</style>
