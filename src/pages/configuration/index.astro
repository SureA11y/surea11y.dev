---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionMenu from "../../components/SectionMenu.astro";
import { configurationSections } from "../../data/configurationSections";
---

<BaseLayout title="Configuration">
	<h1>Configuration</h1>
	<p>
		Engine options, CI integration, and locales — pick a topic below.
	</p>
	<SectionMenu sections={configurationSections} />
</BaseLayout>

<style>
	h1 {
		font-family: var(--font-display);
		color: var(--text-strong);
	}

	p {
		line-height: var(--leading-relaxed);
	}
</style>
