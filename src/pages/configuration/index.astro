---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Callout } from "../../components/design-system/feedback/Callout.jsx";
---

<BaseLayout title="Configuration">
	<h1>Configuration</h1>
	<Callout tone="note">
		Engine options, CI integration, and locales aren't written up yet —
		they'll come from <code>ENGINE_OPTIONS.md</code>,
		<code>CI_INTEGRATIONS.md</code>, and the end-user portion of
		<code>I18N.md</code>.
	</Callout>
</BaseLayout>

<style>
	h1 {
		font-family: var(--font-display);
		color: var(--text-strong);
	}

	code {
		font-family: var(--font-mono);
	}
</style>
