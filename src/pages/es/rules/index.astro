---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { RulesTable } from "../../../components/RulesTable.jsx";
import rules from "../../../data/rules.generated.json";
import { localizeRule } from "../../../data/localizeRule";
import { t } from "../../../i18n/t";

const locale = "es";
const localizedRules = rules.map((r) => localizeRule(r, locale));
const automatic = localizedRules.filter((r) => r.type === "automatic");
const manual = localizedRules.filter((r) => r.type === "manual");
---

<BaseLayout
	title="Reglas"
	description="Explora todas las reglas: qué comprueba cada una y un ejemplo de aprobado/fallido."
>
	<h1>Reglas</h1>
	<p>
		Los 34 resúmenes compuestos por Criterio de Éxito de WCAG no aparecen aquí:
		no son reglas configurables individualmente, pertenecen a <a href="/conformance/wcag-mapping/">Conformidad</a> en su lugar.
		Consulta <a href="/rules/organization/">cómo se organizan las reglas</a> para ver automáticas frente a manuales, cómo se estructuran los ID de regla y las facetas de WCAG.
	</p>

	<h2>{t("rulesIndex.automaticHeading", locale, { n: automatic.length })} <code>fail</code></h2>
	<RulesTable caption={`${automatic.length} reglas automáticas`} rows={automatic} locale={locale} />

	<h2>{t("rulesIndex.manualHeading", locale, { n: manual.length })} <code>cantTell</code></h2>
	<RulesTable caption={`${manual.length} reglas manuales`} rows={manual} locale={locale} />
</BaseLayout>
