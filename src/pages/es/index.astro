---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Badge } from "../../components/design-system/core/Badge.jsx";
import { Button } from "../../components/design-system/core/Button.jsx";
import { Card } from "../../components/design-system/core/Card.jsx";
import { Logo } from "../../components/design-system/brand/Logo.jsx";
import { OverviewContent } from "../../components/OverviewContent.jsx";
import { sections } from "../../data/sections";
import { localize } from "../../data/localize";
import { t } from "../../i18n/t";
import engine from "../../data/engine.generated.json";

const locale = "es";
const otherSections = sections.filter((section) => section.href !== "/");
---

<BaseLayout
	title="Overview"
	description="Deterministic WCAG 2.2 accessibility testing for Playwright, Cypress, Puppeteer, Selenium, WebdriverIO, Jest/Vitest, and CI — verified against the W3C ACT rules corpus, and honest about what it can't tell you."
>
	<h1><Logo variant="lockup" size={40} /></h1>

	<p class="tagline">Accessibility testing that tells you what it can't tell you.</p>
	<p>
		Deterministic accessibility testing for Playwright, Cypress, Puppeteer, Selenium, WebdriverIO,
		Jest/Vitest, and CI pipelines.
	</p>
	<div class="hero-actions">
		<Button as="a" href="/es/getting-started/" variant="secondary">
			{t("homepage.getStarted", locale)}
		</Button>
		<Button as="a" href="https://github.com/SureA11y/core" variant="outline">
			{t("homepage.viewOnGitHub", locale)}
		</Button>
	</div>
	<p class="hero-stats">
		<a href="#checked-against-the-act-corpus">
			58 ACT rules · 798 reference cases · deterministic results · explicit uncertainty
		</a>
	</p>
	<div class="badges">
		<Badge label="engine" value={`v${engine.version}`} tone="neutral" />
		<Badge label="license" value={engine.license} tone="neutral" />
	</div>

	<OverviewContent />
	<nav aria-label={t("homepage.exploreSections", locale)}>
		<ul class="section-grid">
			{
				otherSections.map((section) => {
					const { label } = localize(section, locale);
					return (
						<li>
							<a class="section-card" href={`/es${section.href}`}>
								<Card>
									<p class="section-card-title">{label}</p>
									<p>{section.description}</p>
								</Card>
							</a>
						</li>
					);
				})
			}
		</ul>
	</nav>
</BaseLayout>

<style>
	.badges {
		display: flex;
		gap: var(--space-2);
		margin: var(--space-4) 0 var(--space-6);
	}

	:global(.tagline) {
		font-family: var(--font-display);
		font-size: var(--text-lg);
		color: var(--text-strong);
	}

	.hero-sub {
		max-width: 60ch;
		color: var(--text-body);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin: var(--space-4) 0;
	}

	.hero-stats {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	:global(blockquote) {
		margin: var(--space-4) 0;
		padding-left: var(--space-5);
		border-left: var(--stroke-accent-bar) solid var(--accent-2);
		font-family: var(--font-display);
		font-size: var(--text-md);
		color: var(--text-strong);
	}

	:global(.outcome-list) {
		list-style: none;
		padding: 0;
	}

	:global(.outcome-list li) {
		display: flex;
		align-items: baseline;
		gap: var(--space-2);
	}

	.section-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: var(--space-4);
		margin-top: var(--space-8);
		list-style: none;
		margin-left: 0;
		margin-right: 0;
		padding: 0;
	}

	.section-grid > li {
		margin-bottom: 0;
	}

	.section-card {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.section-card:hover :global(> div) {
		border-color: var(--border-strong);
	}

	.section-card:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
		border-radius: var(--radius-sm);
	}

	.section-card :global(.section-card-title) {
		margin: 0 0 var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-md);
		color: var(--text-strong);
	}

	.section-card :global(p) {
		margin: 0;
		font-family: var(--font-body);
		font-size: var(--text-sm);
		color: var(--text-body);
	}
</style>
