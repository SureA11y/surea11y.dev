---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { RuleOrganizationContent } from "../../../components/RuleOrganizationContent.jsx";
---

<BaseLayout title="How rules are organized">
	<h1>How rules are organized</h1>
	<RuleOrganizationContent />
</BaseLayout>

<style>
	h1 {
		font-family: var(--font-display);
		color: var(--text-strong);
	}

	:global(h2) {
		font-family: var(--font-display);
		color: var(--text-strong);
		font-size: var(--text-lg);
		margin-top: var(--space-10);
	}

	:global(p),
	:global(li) {
		line-height: var(--leading-relaxed);
	}

	:global(li) {
		margin-bottom: var(--space-3);
	}

	:global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
	}
</style>
