---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { RulesTable } from "../../components/RulesTable.jsx";
import rules from "../../data/rules.generated.json";

const automatic = rules.filter((r) => r.type === "automatic");
const manual = rules.filter((r) => r.type === "manual");
---

<BaseLayout title="Rules">
	<h1>Rules</h1>
	<p>
		The 34 composite WCAG Success Criterion rollups aren't listed here —
		they aren't individually configurable rules, they belong under <a href="/conformance/">Conformance</a> instead.
		See <a href="/rules/organization/">how rules are organized</a> for automatic vs. manual, how rule IDs are structured, and WCAG facets.
	</p>

	<h2>Automatic ({automatic.length}), can return <code>fail</code></h2>
	<RulesTable caption={`${automatic.length} automatic rules`} rows={automatic} />

	<h2>Manual ({manual.length}), advisory, capped at <code>cantTell</code></h2>
	<RulesTable caption={`${manual.length} manual rules`} rows={manual} />
</BaseLayout>

<style>
	h1,
	h2 {
		font-family: var(--font-display);
		color: var(--text-strong);
	}

	h2 {
		font-size: var(--text-lg);
		margin-top: var(--space-10);
	}

	code {
		font-family: var(--font-mono);
	}
</style>
