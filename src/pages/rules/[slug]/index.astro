---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { RulePage } from "../../../components/RulePage.jsx";
import rules from "../../../data/rules.generated.json";

export function getStaticPaths() {
	return rules.map((rule) => ({ params: { slug: rule.ruleId }, props: { rule } }));
}

interface Props {
	rule: (typeof rules)[number];
}

const { rule } = Astro.props;
---

<BaseLayout title={rule.title}>
	<RulePage rule={rule} />
</BaseLayout>

<style>
	:global(.rule-kicker) {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--text-muted);
		margin: 0;
	}

	:global(article h1) {
		font-family: var(--font-display);
		color: var(--text-strong);
		margin-top: var(--space-1);
	}

	:global(article h2) {
		font-family: var(--font-display);
		color: var(--text-strong);
		font-size: var(--text-lg);
		margin-top: var(--space-10);
	}

	:global(.tag-row) {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: var(--space-4) 0 var(--space-6);
	}

	:global(.rule-description) {
		font-size: var(--text-md);
	}

	:global(.example) {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	:global(.related-rules) {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
		list-style: none;
		padding: 0;
	}

	:global(.view-source) {
		margin-top: var(--space-10);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
	}
</style>
