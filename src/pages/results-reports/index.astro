---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionMenu from "../../components/SectionMenu.astro";
import { resultsReportsSections } from "../../data/resultsReportsSections";
---

<BaseLayout title="Results & Reports">
	<h1>Results & Reports</h1>
	<p>
		The raw output schema, and the three report formats built on top of it — pick a topic below.
	</p>
	<SectionMenu sections={resultsReportsSections} />
</BaseLayout>

<style>
	h1 {
		font-family: var(--font-display);
		color: var(--text-strong);
	}

	p {
		line-height: var(--leading-relaxed);
	}
</style>
