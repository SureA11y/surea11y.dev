---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionMenu from "../../components/SectionMenu.astro";
import { conformanceSections } from "../../data/conformanceSections";
---

<BaseLayout title="Conformance">
	<h1>Conformance</h1>
	<p>
		How rule results map to WCAG, and how to gate CI on known, reviewed violations — pick a topic
		below.
	</p>
	<SectionMenu sections={conformanceSections} />
</BaseLayout>

<style>
	h1 {
		font-family: var(--font-display);
		color: var(--text-strong);
	}

	p {
		line-height: var(--leading-relaxed);
	}
</style>
