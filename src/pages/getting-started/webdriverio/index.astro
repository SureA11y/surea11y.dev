---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GettingStartedMenu from "../../../components/GettingStartedMenu.astro";
import { UsageBindingSection } from "../../../components/UsageBindingSection.jsx";
import { bindingUsage } from "../../../data/bindingUsage.jsx";
---

<BaseLayout title="Usage with WebdriverIO">
	<h1>Usage with WebdriverIO</h1>
	<GettingStartedMenu />
	<UsageBindingSection {...bindingUsage.webdriverio} />
</BaseLayout>

<style>
	h1 {
		font-family: var(--font-display);
		color: var(--text-strong);
	}

	:global(p) {
		line-height: var(--leading-relaxed);
	}

	:global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
	}
</style>
