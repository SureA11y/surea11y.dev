---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GettingStartedMenu from "../../../components/GettingStartedMenu.astro";
import { CliUsageContent } from "../../../components/CliUsageContent.jsx";
---

<BaseLayout title="Usage via CLI">
	<h1>Usage via CLI</h1>
	<GettingStartedMenu />
	<CliUsageContent />
</BaseLayout>

<style>
	h1 {
		font-family: var(--font-display);
		color: var(--text-strong);
	}

	:global(p) {
		line-height: var(--leading-relaxed);
	}

	:global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
	}
</style>
