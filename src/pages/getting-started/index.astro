---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Callout } from "../../components/design-system/feedback/Callout.jsx";
---

<BaseLayout title="Getting Started">
	<h1>Getting Started</h1>
	<Callout tone="note">
		One flowing page, anchor-linked by binding, isn't built yet:
		installation, the shared "Usage" concept from
		<code>OUTPUT_SCHEMA.md</code>, per-binding usage adapted from each
		binding's own README, and the standalone/browser-bundle path from
		<code>INTEGRATION.md</code>.
	</Callout>
</BaseLayout>

<style>
	h1 {
		font-family: var(--font-display);
		color: var(--text-strong);
	}

	code {
		font-family: var(--font-mono);
	}
</style>
