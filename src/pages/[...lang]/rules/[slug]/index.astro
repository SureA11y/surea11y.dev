---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { RulePage } from "../../../../components/RulePage.jsx";
import { plainRuleText } from "../../../../components/RuleText.jsx";
import rules from "../../../../data/rules.generated.json";
import { isRuleTranslated, localizeRule } from "../../../../data/localizeRule";
import { DEFAULT_LOCALE, localeCodes } from "../../../../i18n/locales";
import { localeParam } from "../../../../i18n/paths";
import type { Locale } from "../../../../i18n/t";

export function getStaticPaths() {
	return localeCodes.flatMap((locale) =>
		rules.map((rule) => ({ params: { lang: localeParam(locale), slug: rule.ruleId }, props: { rule, locale } }))
	);
}

interface Props {
	rule: (typeof rules)[number];
	locale: Locale;
}

const { ruleId } = Astro.props.rule;
const locale = isRuleTranslated(ruleId, Astro.props.locale) ? Astro.props.locale : DEFAULT_LOCALE;
const rule = localizeRule(Astro.props.rule, locale);
const available = localeCodes.filter((l) => isRuleTranslated(ruleId, l));
---

<BaseLayout
	title={plainRuleText(rule.title)}
	description={plainRuleText(rule.description)}
	breadcrumbLabel={rule.ruleId}
	contentLocale={locale}
	translatedLocales={available}
>
	<RulePage rule={rule} locale={locale} />
</BaseLayout>

<style>
	:global(.rule-kicker) {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--text-muted);
		margin: 0;
	}

	:global(article h1) {
		margin-top: var(--space-1);
	}

	:global(.tag-row) {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: var(--space-4) 0 var(--space-6);
	}

	:global(.rule-description) {
		font-size: var(--text-md);
	}

	:global(.example) {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	:global(.example-heading) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3);
	}

	:global(.example-context) {
		color: var(--text-muted);
		font-size: var(--text-sm);
	}

	:global(.related-rules) {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
		list-style: none;
		padding: 0;
	}

	:global(.view-source) {
		margin-top: var(--space-10);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
	}
</style>
