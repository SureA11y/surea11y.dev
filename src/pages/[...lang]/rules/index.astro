---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { RulesTable } from "../../../components/RulesTable.jsx";
import rules from "../../../data/rules.generated.json";
import { sections } from "../../../data/sections";
import { localize } from "../../../data/localize";
import { isRuleTranslated, localizeRule } from "../../../data/localizeRule";
import { localizedModule, translatedLocales } from "../../../i18n/content";
import { localeStaticPaths } from "../../../i18n/paths";
import { t, type Locale } from "../../../i18n/t";

export const getStaticPaths = localeStaticPaths;

interface Props {
	locale: Locale;
}

// The intro paragraph decides the page's language; rule titles in the tables
// are localized independently, per rule, as far as each locale's overlay goes.
const { module, locale } = localizedModule("component", "RulesIntroContent", Astro.props.locale);
const { RulesIntroContent } = module;
const rulesSection = sections.find((s) => s.href === "/rules/")!;
const { label, description } = localize(rulesSection, locale);

const localizedRules = rules.map((r) => localizeRule(r, locale));
const automatic = localizedRules.filter((r) => r.type === "automatic");
const manual = localizedRules.filter((r) => r.type === "manual");
// "{outcome}" stays in the translated heading so each language places the
// <code> where its word order needs it.
const heading = (key: string, n: number) => t(key, locale, { n }).split("{outcome}");
const [autoBefore, autoAfter] = heading("rulesIndex.automaticHeading", automatic.length);
const [manualBefore, manualAfter] = heading("rulesIndex.manualHeading", manual.length);

const available = translatedLocales("component", "RulesIntroContent").filter((l) =>
	rules.every((r) => isRuleTranslated(r.ruleId, l))
);
---

<BaseLayout
	title={label}
	description={description}
	contentLocale={locale}
	translatedLocales={available}
	toc={false}
>
	<h1>{label}</h1>
	<RulesIntroContent />

	<h2>{autoBefore}<code>fail</code>{autoAfter}</h2>
	<RulesTable caption={t("rulesIndex.automaticCaption", locale, { n: automatic.length })} rows={automatic} locale={locale} />

	<h2>{manualBefore}<code>cantTell</code>{manualAfter}</h2>
	<RulesTable caption={t("rulesIndex.manualCaption", locale, { n: manual.length })} rows={manual} locale={locale} />
</BaseLayout>
