---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Callout } from "../components/design-system/feedback/Callout.jsx";
import { Badge } from "../components/design-system/core/Badge.jsx";
import { Card } from "../components/design-system/core/Card.jsx";
import { sections } from "../data/sections";

const otherSections = sections.filter((section) => section.href !== "/");
---

<BaseLayout title="Overview">
	<h1>surea11y</h1>
	<div class="badges">
		{/* mirrors ../core/package.json — re-copy if it changes */}
		<Badge label="engine" value="v1.7.0" tone="neutral" />
		<Badge label="license" value="MPL-2.0" tone="neutral" />
	</div>
	<Callout tone="note">
		Docs and rules site scaffold. The Overview page itself — what
		surea11y is, the engine-plus-bindings model, how its results differ
		from other tools — hasn't been written yet.
	</Callout>
	<div class="section-grid">
		{
			otherSections.map((section) => (
				<a class="section-card" href={section.href}>
					<Card>
						<h2>{section.label}</h2>
						<p>{section.description}</p>
					</Card>
				</a>
			))
		}
	</div>
</BaseLayout>

<style>
	h1 {
		font-family: var(--font-display);
		color: var(--text-strong);
	}

	.badges {
		display: flex;
		gap: var(--space-2);
		margin: var(--space-4) 0 var(--space-6);
	}

	.section-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: var(--space-4);
		margin-top: var(--space-8);
	}

	.section-card {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.section-card:hover :global(> div) {
		border-color: var(--border-strong);
	}

	.section-card:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
		border-radius: var(--radius-sm);
	}

	.section-card :global(h2) {
		margin: 0 0 var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-md);
		font-weight: var(--weight-medium);
		color: var(--text-strong);
	}

	.section-card :global(p) {
		margin: 0;
		font-family: var(--font-body);
		font-size: var(--text-sm);
		color: var(--text-body);
	}
</style>
