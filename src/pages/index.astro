---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Badge } from "../components/design-system/core/Badge.jsx";
import { Card } from "../components/design-system/core/Card.jsx";
import { OverviewContent } from "../components/OverviewContent.jsx";
import { sections } from "../data/sections";

const otherSections = sections.filter((section) => section.href !== "/");
---

<BaseLayout title="Overview">
	<h1>surea11y</h1>
	<div class="badges" data-surface="light">
		{/* mirrors ../core/package.json — re-copy if it changes */}
		<Badge label="engine" value="v1.7.0" tone="neutral" />
		<Badge label="license" value="MPL-2.0" tone="neutral" />
	</div>
	<OverviewContent />
	<div class="section-grid">
		{
			otherSections.map((section) => (
				<a class="section-card" href={section.href}>
					<Card>
						<h2>{section.label}</h2>
						<p>{section.description}</p>
					</Card>
				</a>
			))
		}
	</div>
</BaseLayout>

<style>
	h1 {
		font-family: var(--font-display);
		color: var(--text-strong);
	}

	.badges {
		display: flex;
		gap: var(--space-2);
		margin: var(--space-4) 0 var(--space-6);
	}

	:global(.tagline) {
		font-family: var(--font-display);
		font-size: var(--text-lg);
		color: var(--text-strong);
	}

	:global(h2) {
		font-family: var(--font-display);
		color: var(--text-strong);
		font-size: var(--text-lg);
		margin-top: var(--space-10);
	}

	:global(h3) {
		font-family: var(--font-display);
		color: var(--text-strong);
		font-size: var(--text-md);
		margin-top: var(--space-8);
	}

	:global(p),
	:global(li) {
		line-height: var(--leading-relaxed);
	}

	:global(li) {
		margin-bottom: var(--space-3);
	}

	:global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
	}

	:global(blockquote) {
		margin: var(--space-4) 0;
		padding-left: var(--space-5);
		border-left: var(--stroke-accent-bar) solid var(--accent-2);
		font-family: var(--font-display);
		font-size: var(--text-md);
		color: var(--text-strong);
	}

	:global(.outcome-list) {
		list-style: none;
		padding: 0;
	}

	:global(.outcome-list li) {
		display: flex;
		align-items: baseline;
		gap: var(--space-2);
	}

	.section-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: var(--space-4);
		margin-top: var(--space-8);
	}

	.section-card {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.section-card:hover :global(> div) {
		border-color: var(--border-strong);
	}

	.section-card:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
		border-radius: var(--radius-sm);
	}

	.section-card :global(h2) {
		margin: 0 0 var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-md);
		color: var(--text-strong);
	}

	.section-card :global(p) {
		margin: 0;
		font-family: var(--font-body);
		font-size: var(--text-sm);
		color: var(--text-body);
	}
</style>
