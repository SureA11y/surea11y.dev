---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionMenu from "../../components/SectionMenu.astro";
import { troubleshootingSections } from "../../data/troubleshootingSections";
---

<BaseLayout title="Troubleshooting">
	<h1>Troubleshooting</h1>
	<p>
		Answers to common questions, and what this engine deliberately does not attempt — pick a topic
		below.
	</p>
	<SectionMenu sections={troubleshootingSections} />
</BaseLayout>

<style>
	h1 {
		font-family: var(--font-display);
		color: var(--text-strong);
	}

	p {
		line-height: var(--leading-relaxed);
	}
</style>
